{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/techdigiedu/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "installCommand": "pnpm -w install",
  "buildCommand": "pnpm -w --filter ./artifacts/techdigiedu... run build",
  "devCommand": "pnpm -C artifacts/techdigiedu run dev",
  "framework": "vite",
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  }
}
